{
  "name": "424GoldMagpie",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@adobe/aio-sdk": "^6",
    "@adobe/uix-guest": "^1.1.12",
    "node-fetch": "^2.6.0",
    "cloudevents": "^4.0.2",
    "uuid": "^8.0.0",
    "regenerator-runtime": "^0.13.5",
    "@adobe/exc-app": "^1.3.0"
  },
  "devDependencies": {
    "jest": "^29",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "eslint": "^8",
    "eslint-plugin-jest": "^27.2.3"
  },
  "scripts": {
    "build:extension": "aio app build --extension aem/cf-console-admin/1 --no-actions",
    "build:wknd": "node scripts/build-wknd.cjs",
    "deploy:wknd": "aio app deploy --extension application --no-actions --no-publish --no-log-forwarding-update",
    "test": "jest --passWithNoTests ./test",
    "test:wknd": "npm --prefix react-app test -- --watchAll=false --runInBand --roots src ../next-js/lib --modulePaths \"<rootDir>/node_modules\" --moduleNameMapper \"{\\\"^react$\\\":\\\"<rootDir>/node_modules/react\\\"}\" --testMatch \"**/?(*.)(spec|test).[jt]s?(x)\"",
    "e2e": "jest --collectCoverage=false --testRegex ./e2e",
    "lint": "eslint --ignore-pattern web-src --no-error-on-unmatched-pattern test src actions scripts",
    "lint:fix": "npm run lint -- --fix"
  },
  "engines": {
    "node": ">=18"
  }
}
